{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "barryvdh/laravel-dompdf": "^3.1",
        "doctrine/dbal": "^4.4",
        "google/apiclient": "2.15",
        "guzzlehttp/guzzle": "^7.9",
        "intervention/image": "^3.11",
        "intervention/image-laravel": "^1.5",
        "jenssegers/agent": "^2.6",
        "kreait/firebase-php": "^7.24",
        "laravel/framework": "^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "mpdf/mpdf": "^8.2",
        "predis/predis": "*",
        "rap2hpoutre/fast-excel": "^5.3",
        "razorpay/razorpay": "^2.9",
        "rosell-dk/webp-convert": "^2.9",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "spatie/laravel-backup": "^9.0",
        "spatie/laravel-sitemap": "^8.0",
        "stichoza/google-translate-php": "^5.3",
        "stripe/stripe-php": "^13.11",
        "twilio/sdk": "^7.7",
        "yajra/laravel-datatables": "^12.0",
        "yajra/laravel-datatables-oracle": "^12.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "fakerphp/faker": "^1.23",
        "laravel/sail": "^1.30",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/GeneralHelper.php",
            "app/Helpers/MailerHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "intervention/image"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
